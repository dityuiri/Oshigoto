# Copy to .env (gitignored). Real environment variables win over this file.

# /admin login (HTTP Basic). Admin is disabled while ADMIN_PASSWORD is empty.
ADMIN_USER=dity
ADMIN_PASSWORD=

# Leave unset for SQLite at data/oshigoto.db. For Postgres:
# DATABASE_URL=postgresql+psycopg://oshigoto:PASSWORD@postgres:5432/oshigoto

# Where the SQLite file and downloaded images live (default: ./data)
# OSHIGOTO_DATA=/data
